#!/bin/bash
PS4='+ ${BASH_SOURCE}:${LINENO}:${FUNCNAME[0]}: '
##############################################################################################################################
# A simple script to dump a backup file. This can be loaded with db_load.
#
# For use on localhost. 
##############################################################################################################################

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

# Configurable dirs
source_dir="${script_dir%/*}"      	# dir above the script's dir
project_dir="${source_dir%/*/*}"	# dir two steps above the source dir
backup_dir="$project_dir/Backups"

backup_prefix=$(date +%Y-%m-%d)

# Default Database configs
host=localhost
port=5432
admin=postgres

# An external script that provides db configs from Django settings
# It should provide:
#    DB_HOST
#    DB_PORT
#    DB_NAME
#    DB_USER
#    DB_PASSWORD
# Which will override the defaults above if found
db_var_provider="$script_dir/db_vars"

supported_args="SDVh"

show_help_and_exit () {
	echo "Usage: db_dump [-$supported_args] database"
	echo ""
	echo "where:"
	echo "	-S use SQL for the backup and restore rather than the PostgreSQL binary (custom) format"
	echo "	-D requests a dry run that echoes all commands that would be run (but aren't)"
	echo "	-V verbose (add some extra diagnostic output)"
	echo "	-h Show help"
	echo ""
	echo "	database is the name of database to dump"
	echo ""
	exit
}

use_sql=false
dry_run=false
verbose=false

while getopts "$supported_args" flag; do
	case "$flag" in
		S) use_sql=true ;;
		D) dry_run=true ;;
		V) verbose=true ;;
		h) show_help_and_exit;;
	esac
done

shift $((OPTIND-1))
database=$1

check_pg_access() {
    local db="${1:-postgres}"   # database to test against, defaults to 'postgres'

    # -w      : never prompt for a password (fails fast instead of hanging)
    # -tAq    : quiet, unaligned, tuples-only output (don't care about it here)
    # < /dev/null : belt-and-braces, also stops psql reading stray stdin
    if psql -h "$host" -p "$port" -U "$admin" -d "$db" -w -tAq -c 'SELECT 1;' >/dev/null 2>&1 </dev/null; then
		if [ $verbose == true ]; then
        	echo "✔ '$admin' can access '$db' on $host:$port"
        fi
        return 0
    fi

    echo "✘ '$admin' could NOT access '$db' on $host:$port (no password prompt allowed)." >&2
    echo "" >&2
    echo "  Fix this one of two ways:" >&2
    echo "" >&2
    echo "  1) Set PGPASSWORD for this shell/script:" >&2
    echo "       export PGPASSWORD='the_password'" >&2
    echo "" >&2
    echo "  2) Or add a line to ~/.pgpass (chmod 600 it if it isn't already) like this:" >&2
    echo "       $host:$port:*:$admin:the_password" >&2
    echo "" >&2
    echo "     e.g.:" >&2
    echo "       echo '$host:$port:*:$admin:the_password' >> ~/.pgpass" >&2
    echo "       chmod 600 ~/.pgpass" >&2
    return 1
}

check_pg_access || exit 1

if [ "$database" == "" ]; then
	echo -e "No database specified. Will look for the Django configured database."
	
	# Try and get db_vars from the Django config through the configured provider
	if [[ -e "$db_var_provider" ]]; then
		if file -b "$db_var_provider" | grep -q '^Bourne-Again shell script'; then
			is_static_assignment() {
	    		[[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*=([A-Za-z0-9_./:-]+|\"[^\"]*\"|\'[^\']*\')$ ]]
			}
			
			only_valid_assignments() {
			    local output="$1"
			    local line
			
			    while IFS= read -r line; do
			        [[ -z $line ]] && continue
			
			        if ! is_static_assignment "$line"; then
			            printf 'Rejected: %q\n' "$line" >&2
			            return 1
			        fi
			    done <<< "$output"
			
			    return 0
			}
			
			declarations="$("$db_var_provider")"
		
			if only_valid_assignments "$declarations"; then
		    	eval "$declarations"
		    fi
		    
		    # Override defaults with Django settings if provided
		    host=${DB_HOST:-$host}	
		    port=${DB_PORT:-$port}
		    database=${DB_NAME:-$database}
		    user=${DB_USER:-$user}
	    fi
	fi
	
	if [[ -n ${database:-} ]]; then
		echo -e "\tFound: $database"
	else
		echo -e "\tNone found\n"
		show_help_and_exit
	fi 
fi


# Dryrun support is provided via run functions
command_line() {
    local arg

    for arg in "$@"; do
        if [[ $arg =~ [[:space:]] ]]; then
            printf '"%s" ' "$arg"
        else
            printf '%s ' "$arg"
        fi
    done
}

run() {
    if [[ $dry_run == true ]]; then
        printf '\t'
        command_line "$@"
        printf '\n'
    else
        "$@"
    fi
}

run_quiet() {
    if [[ $dry_run == true ]]; then
        printf '\t'
        command_line "$@"
        printf '>/dev/null\n'
    else
        "$@" >/dev/null
    fi
}

if [ $use_sql == true ]; then format=""; else format="--format=custom"; fi  

args="--host=$host --port=$port --username=$admin $format"

if [ $use_sql == true ]; then backup_extension="sql"; else backup_extension="backup"; fi
backup_file="$backup_dir/$backup_prefix $database Database - $host.$backup_extension"

if [ $dry_run == true ] || [ $verbose == true ]; then
	echo CONFIG:
	echo -e "\tscript_dir: $script_dir"
	echo -e "\tsource_dir: $source_dir"
	echo -e "\tproject_dir: $project_dir"
	echo -e "\tbackup_dir: $backup_dir"
	echo -e "\tbackup_prefix: $backup_prefix"
	echo -e "\tbackup_extension: $backup_extension"
	echo -e "\tbackup_file: $backup_file"
	echo -e "\thost: $host"
	echo -e "\tport: $port"
	echo -e "\tformat: $format"
	echo -e "\targs: $args"
	echo
fi

if [ $dry_run == true ]; then
	echo "Dry run (commands that would be executed are):"
fi

run pg_dump $args --dbname="$database" --file="$backup_file" 

if [ $dry_run == true ]; then 
	echo;
	dry_note=" would have been"
else
	dry_note="" 
fi

echo "Database$dry_note dumped to:" 
echo -e "    $backup_file"